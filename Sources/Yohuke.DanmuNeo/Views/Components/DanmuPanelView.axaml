<components:WorkbenchRoomPanel xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:workspace="clr-namespace:Yohuke.DanmuNeo.Models.Workspace"
                               xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
                               xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
                               xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
                               x:Class="Yohuke.DanmuNeo.Views.Components.DanmuPanelView"
                               x:DataType="items:LiveRoomTabViewModel"
                               x:CompileBindings="True"
                               x:Name="Root">
    <components:WorkbenchRoomPanel.HeaderActionsTemplate>
        <DataTemplate x:DataType="components:DanmuPanelView">
            <Button x:Name="DanmuScrollToTopButton"
                    Classes="dockChromeButton"
                    Foreground="{DynamicResource AppMutedTextBrush}"
                    ToolTip.Tip="{Loc Key=UI.DanmuPanelView.ScrollToTop}"
                    AutomationProperties.Name="{Loc Key=UI.DanmuPanelView.ScrollToTop}"
                    Command="{Binding ScrollToTopCommand}">
                <LucideIcon Kind="ArrowUpToLine" Width="16" Height="16" />
            </Button>
        </DataTemplate>
    </components:WorkbenchRoomPanel.HeaderActionsTemplate>
    <Border Padding="{StaticResource WorkbenchPanelPadding}">
        <Grid Classes.compactDanmu="{Binding #Root.Context.Application.IsCompactDanmuDisplay}"
              Classes.compactDanmuWrap="{Binding #Root.Context.Application.IsCompactDanmuWrap}"
              Classes.compactSuperChatWrap="{Binding #Root.Context.Application.IsCompactSuperChatWrap}">
            <ScrollViewer x:Name="DanmuScrollViewer"
                          Margin="0">
                <ItemsControl x:Name="DanmuItemsControl"
                              Classes="scrollSafeContent danmuFeedList"
                              ItemsSource="{Binding DanmuItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="workspace:DanmuFeedItem">
                            <Button Classes="danmuFeedButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    ContextRequested="Danmu_OnContextRequested"
                                    Click="Danmu_OnClick">
                                <Grid Classes="danmuFeedLayout"
                                      RowDefinitions="Auto">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="160" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Classes="danmuFeedIdentity"
                                          Classes.historyDanmu="{Binding IsHistory}"
                                          ColumnDefinitions="Auto,Auto,*"
                                          ClipToBounds="True"
                                          VerticalAlignment="Center">
                                        <Grid.Styles>
                                            <Style Selector="Grid.compactDanmu Grid.danmuFeedIdentity:not(.historyDanmu) Button.feedUserNameButton">
                                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                            </Style>
                                        </Grid.Styles>
                                        <Border Classes="danmuMedalBadge"
                                                BorderBrush="{Binding MedalBorderBrush}"
                                                IsVisible="{Binding HasMedal}"
                                                ToolTip.Tip="{Binding MedalText}">
                                            <Grid Classes="danmuMedalLayout"
                                                  ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding MedalDisplayName}"
                                                           Classes="danmuMedalText danmuMedalName"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding MedalLevel}"
                                                           Classes="danmuMedalText danmuMedalLevel"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                        <Border Classes="danmuMedalPlaceholder"
                                                IsVisible="{Binding ShowNoMedalPlaceholder}">
                                            <TextBlock Text="{Loc Key=Room.NoMedal}"
                                                       Classes="danmuMedalText"
                                                       TextAlignment="Center" />
                                        </Border>
                                        <components:UserAvatarView Grid.Column="1"
                                                                   UserUid="{Binding AvatarUid}"
                                                                   AvatarService="{Binding #Root.Context.Application.UserAvatars}"
                                                                   ShowAvatar="{Binding #Root.Context.Application.IsShowDanmuAvatars}"
                                                                   Margin="0,0,6,0" />
                                        <Grid Grid.Column="2"
                                              ColumnDefinitions="2*,*"
                                              VerticalAlignment="Center">
                                            <Button Classes="feedUserNameButton"
                                                    Click="FeedUserName_OnClick">
                                                <TextBlock Text="{Binding UserName}"
                                                           Classes="danmuFeedUser"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Button>
                                            <Grid Grid.Column="1"
                                                  ColumnDefinitions="*,Auto"
                                                  ClipToBounds="True"
                                                  VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DetailLine}"
                                                           Classes="danmuFeedMeta"
                                                           Margin="6,0,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Loc Key=Room.History.Badge}"
                                                           IsVisible="{Binding IsHistory}"
                                                           Classes="muted"
                                                           Margin="6,0,0,0" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                    <components:EmoticonTextBlock Grid.Column="1"
                                                                  ContentText="{Binding Content}"
                                                                  Emoticons="{Binding Emoticons}"
                                                                  Reply="{Binding Reply}"
                                                                  AvatarService="{Binding #Root.Context.Application.UserAvatars}"
                                                                  ShowReplyAvatar="{Binding #Root.Context.Application.IsShowDanmuAvatars}"
                                                                  Classes="danmuFeedContent regularFeedContent"
                                                                  TextWrapping="Wrap" />
                                    <components:HoverMarqueeTextBlock Grid.Column="1"
                                                                      Text="{Binding Content}"
                                                                      Emoticons="{Binding Emoticons}"
                                                                      Reply="{Binding Reply}"
                                                                      AvatarService="{Binding #Root.Context.Application.UserAvatars}"
                                                                      ShowReplyAvatar="{Binding #Root.Context.Application.IsShowDanmuAvatars}"
                                                                      Classes="compactFeedContent" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</components:WorkbenchRoomPanel>
